<Window x:Class="Stroika.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Stroika"
        mc:Ignorable="d"
        Title="Заявка" Height="550" Width="700"
        Background="#FFFFFF" WindowStartupLocation="CenterScreen"
        FontFamily="Bahnhofschrift Light SemiCondensed">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Text="Новая заявка" 
                   FontSize="20" FontWeight="Bold" Foreground="#0C4882" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Партнер:" Margin="0,0,0,3"/>
            <ComboBox x:Name="PartnerCombo" Height="30" DisplayMemberPath="Name" SelectedValuePath="Id"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,15,0,5">
            <TextBlock Text="Добавить продукцию в заявку:" Margin="0,0,0,3"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="ProductCombo" Width="300" Height="30" 
                          DisplayMemberPath="Name" SelectedValuePath="Id"/>
                <TextBlock Text="Кол-во:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <TextBox x:Name="QtyBox" Width="60" Height="30" Text="1"/>
                <Button Content="Добавить" Width="120" Height="30" Margin="10,0,0,0" 
                        Background="#BBDCFA" BorderThickness="0" Click="AddItem_Click"/>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="ItemsGrid" Grid.Row="3" AutoGenerateColumns="False" 
                  CanUserAddRows="False" Background="#FFFFFF" Margin="0,10,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Продукция" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="100"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="70"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="110"/>
                <DataGridTemplateColumn Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="X" Width="30" Height="25" Background="#BBDCFA" 
                                    BorderThickness="0" Click="RemoveItem_Click" Tag="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Text="Итого: " FontSize="16" VerticalAlignment="Center"/>
            <TextBlock x:Name="TotalText" Text="0.00" FontSize="18" FontWeight="Bold" 
                       Foreground="#0C4882" VerticalAlignment="Center" Margin="5,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Назад" Width="120" Height="40" Background="#BBDCFA" 
                    BorderThickness="0" Click="Cancel_Click" Margin="0,0,10,0"/>
            <Button Content="Сохранить" Width="150" Height="40" Background="#BBDCFA" 
                    BorderThickness="0" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
