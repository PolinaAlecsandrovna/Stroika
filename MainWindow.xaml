<Window x:Class="Stroika.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Stroika"
        mc:Ignorable="d"
        Title="Список заявок партнеров" Height="600" Width="800"
        Background="#FFFFFF" FontFamily="Bahnhofschrift Light SemiCondensed"
        Icon="/Resources/icon.ico">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="191*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Заявки партнеров" FontSize="24" Foreground="#0C4882" FontWeight="Bold" Margin="0,0,0,20" Grid.ColumnSpan="2"/>

        <ListBox x:Name="OrdersList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                 HorizontalContentAlignment="Stretch"
                 MouseDoubleClick="OrdersList_MouseDoubleClick" Grid.ColumnSpan="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,5" Padding="10" CornerRadius="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="Bold">
                                    <Run Text="{Binding PartnerType}"/> | <Run Text="{Binding PartnerName}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding FullAddress}" Foreground="Gray"/>
                                <TextBlock Text="{Binding PhoneDisplay}"/>
                                <TextBlock Text="{Binding RatingDisplay}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding TotalCost, StringFormat={}{0:C}}" FontSize="18" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2" Content="Добавить заявку" Height="40" Background="#BBDCFA" BorderThickness="0" Click="AddButton_Click" Margin="0,10,0,0" Grid.ColumnSpan="2"/>
    </Grid>
</Window>
